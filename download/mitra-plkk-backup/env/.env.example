# ============================================================
# Mitra PLKK — Environment Variables Template
# ============================================================
# Copy file ini ke .env.local (dev) atau set di Vercel dashboard (prod)
# Untuk production, GANTI semua value placeholder dengan credentials asli
# ============================================================

# ----- SUPABASE -----
# Project: hfhvsiuebrwrqmqzsroc
NEXT_PUBLIC_SUPABASE_URL=https://hfhvsiuebrwrqmqzsroc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...   # Supabase dashboard → Settings → API → anon key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...        # Supabase dashboard → Settings → API → service_role key (KEEP SECRET!)


# ----- AUTH -----
# Random 32-char string untuk sign JWT session cookie
# Generate: openssl rand -hex 32
SESSION_SECRET=generate_random_32_char_string_here


# ----- APP -----
NODE_ENV=production
NEXT_PUBLIC_APP_NAME=Mitra PLKK
NEXT_PUBLIC_APP_URL=https://mitra-plkk.vercel.app


# ----- GOOGLE DOCS + APPS SCRIPT (AFTER MIGRATION) -----
# Aktifkan migrasi Google Docs (true = pakai Google Docs, false = pakai mammoth lama)
MIGRATION_GOOGLE_DOCS_ENABLED=true

# Dari Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxx

# Dari Apps Script → Deploy → Web App URL
APPS_SCRIPT_WEB_APP_URL=https://script.google.com/macros/s/XXXXX/exec

# Secret untuk HMAC signature verification (optional but recommended)
# Generate: openssl rand -hex 32
# HARUS SAMA dengan AUTH_SECRET di Code.gs Apps Script
APPS_SCRIPT_SECRET=generate_random_32_char_string_here

# Email akun Google "document owner" (tempat semua PKS disimpan)
GOOGLE_DOC_OWNER_EMAIL=plkk.bpjs@gmail.com


# ----- AI PROVIDER (optional — kalau tidak di-set, pakai DB keys) -----
# Hanya untuk initial bootstrap kalau wpa_ai_api_keys kosong
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash


# ----- VERCEL CRON (set di vercel.json) -----
# /api/cron/mutasi — jalan tiap 1 jam untuk process pending mutasi
# Tidak perlu env var, tapi endpoint butuh authorization header
CRON_SECRET=generate_random_string_for_cron_auth


# ----- OPTIONAL: SMTP untuk email notification -----
# Kalau tidak di-set, notifikasi email di-skip (in-app notification tetap jalan)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@bpjsketenagakerjaan.go.id
SMTP_FROM_NAME=Mitra PLKK


# ----- OPTIONAL: Sentry error tracking -----
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=


# ============================================================
# CATATAN SETUP
# ============================================================
# 1. Jangan commit file .env.local ke git! Sudah ada di .gitignore
# 2. Untuk production, set env vars di Vercel dashboard (Project Settings → Environment Variables)
# 3. Setiap env var butuh "redownload" project di Vercel untuk take effect
# 4. Untuk testing lokal, copy .env.example → .env.local, isi value
# 5. Setelah deploy, verify dengan: curl https://mitra-plkk.vercel.app/api/health → harus return {"ok":true}
